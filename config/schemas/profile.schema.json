{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local-llm-agent-lab/profile.schema.json",
  "title": "Local LLM Agent Lab profile",
  "type": "object",
  "required": ["id", "displayName", "runtime", "model", "server", "requirements", "capabilities", "status"],
  "additionalProperties": false,
  "properties": {
    "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9.-]*$"},
    "displayName": {"type": "string", "minLength": 1},
    "description": {"type": "string"},
    "runtime": {
      "type": "object",
      "required": ["adapter", "repository", "revision"],
      "additionalProperties": false,
      "properties": {
        "adapter": {"enum": ["llama-cpp"]},
        "repository": {"type": "string", "minLength": 1},
        "revision": {"type": "string", "minLength": 1},
        "cmakeArgs": {"type": "array", "items": {"type": "string"}}
      }
    },
    "model": {"$ref": "#/$defs/artifact"},
    "draftModel": {"$ref": "#/$defs/artifact"},
    "server": {
      "type": "object",
      "required": ["contextSize", "parallel", "arguments"],
      "additionalProperties": false,
      "properties": {
        "contextSize": {"type": "integer", "minimum": 1024},
        "parallel": {"type": "integer", "minimum": 1},
        "arguments": {"type": "array", "items": {"type": "string"}}
      }
    },
    "requirements": {
      "type": "object",
      "required": ["minimumVramGiB", "recommendedVramGiB"],
      "additionalProperties": false,
      "properties": {
        "minimumVramGiB": {"type": "number", "minimum": 0},
        "recommendedVramGiB": {"type": "number", "minimum": 0}
      }
    },
    "capabilities": {
      "type": "object",
      "required": ["chatCompletions", "toolCalling", "reasoning", "vision", "audio"],
      "additionalProperties": false,
      "properties": {
        "chatCompletions": {"type": ["boolean", "string"]},
        "responses": {"type": ["boolean", "string"]},
        "toolCalling": {"type": ["boolean", "string"]},
        "reasoning": {"type": ["boolean", "string"]},
        "vision": {"type": ["boolean", "string"]},
        "audio": {"type": ["boolean", "string"]}
      }
    },
    "status": {"enum": ["stable", "candidate", "experimental"]}
  },
  "$defs": {
    "artifact": {
      "type": "object",
      "required": ["repository", "file"],
      "additionalProperties": false,
      "properties": {
        "repository": {"type": "string", "pattern": "^[^/]+/[^/]+$"},
        "file": {"type": "string", "minLength": 1},
        "revision": {"type": ["string", "null"]},
        "sha256": {"type": ["string", "null"], "pattern": "^[a-fA-F0-9]{64}$"}
      }
    }
  }
}
