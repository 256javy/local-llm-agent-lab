{
  "id": "saluki-27b-iq2-mix",
  "displayName": "Underdog Saluki 27B IQ2-mix",
  "description": "Qwen 3.8 27B comprimido a 2 bits por Underdog (GSQ-RCO de ISTA-DASLab, Apache-2.0) para conservar tool calling; 7,9 GB. Sin MTP; caché KV Q8_0 gracias al margen de VRAM. Solo texto (no se declara mmproj).",
  "runtime": {
    "adapter": "llama-cpp",
    "repository": "https://github.com/ggml-org/llama.cpp.git",
    "revision": "57291f2644af8c9df0dd8d44395881c5bdcf0ecd",
    "cmakeArgs": [
      "-DGGML_CUDA=ON",
      "-DGGML_NATIVE=OFF",
      "-DBUILD_SHARED_LIBS=OFF",
      "-DCMAKE_CUDA_ARCHITECTURES=120"
    ]
  },
  "model": {
    "repository": "ConwayResearch/Underdog-Saluki-27B-1.0",
    "file": "Underdog-Saluki-27B-1.0-IQ2-mix.gguf",
    "revision": "4f60eba09f4b6db63c72915d328d97e1d93edb8c",
    "sha256": "4a673518b11b1c4445f9b9a9d3c40356f5ba39f6a6260dcb25f3fbfd475d9efb"
  },
  "server": {
    "contextSize": 32768,
    "parallel": 1,
    "arguments": [
      "-ngl",
      "99",
      "-fa",
      "on",
      "-ctk",
      "q8_0",
      "-ctv",
      "q8_0",
      "--jinja",
      "--temp",
      "0.6",
      "--top-p",
      "0.95",
      "--top-k",
      "20",
      "--min-p",
      "0",
      "--presence-penalty",
      "1.0",
      "--reasoning-budget",
      "4096",
      "--reasoning-budget-message",
      "Enough thinking. I will act now with the information I have."
    ]
  },
  "chatTemplate": {
    "thinkingToggleKwarg": "enable_thinking"
  },
  "requirements": {
    "minimumVramGiB": 12,
    "recommendedVramGiB": 16
  },
  "capabilities": {
    "chatCompletions": true,
    "responses": true,
    "toolCalling": true,
    "reasoning": true,
    "vision": false,
    "audio": false
  },
  "status": "experimental"
}
